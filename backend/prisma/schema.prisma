generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  katalyst_management
  higher_management
}

enum ModuleType {
  session
  course
  mentoring
  project
  assignment
  milestone
}

enum Classification {
  mandatory
  optional
  certificate
}

enum ScoringMode {
  objective
  subjective
}

enum EnrollmentStatus {
  enrolled
  completed
}

enum SubmissionStatus {
  pending
  reviewed
  scored
}

enum ReviewerType {
  management
  ai_coach
}

enum NotificationType {
  nudge
  escalation
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  cohortYear   Int?     @map("cohort_year")
  createdAt    DateTime @default(now()) @map("created_at")

  modulesCreated   Module[]       @relation("ModuleCreator")
  enrollments      Enrollment[]
  submissions      Submission[]
  reviews          Review[]
  teamMemberships  TeamMember[]
  notifications    Notification[]

  @@map("users")
}

model Team {
  id   String  @id @default(uuid())
  name String?

  members     TeamMember[]
  submissions Submission[]

  @@map("teams")
}

model Module {
  id             String         @id @default(uuid())
  type           ModuleType
  classification Classification
  scoringMode    ScoringMode    @default(subjective) @map("scoring_mode")
  dueDate        DateTime?      @map("due_date")
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")

  creator     User?        @relation("ModuleCreator", fields: [createdBy], references: [id])
  enrollments Enrollment[]
  submissions Submission[]

  @@map("modules")
}

model Enrollment {
  id       String           @id @default(uuid())
  userId   String           @map("user_id")
  moduleId String           @map("module_id")
  status   EnrollmentStatus @default(enrolled)

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@map("enrollments")
}

model Submission {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  moduleId    String           @map("module_id")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  contentRef  String?          @map("content_ref")
  status      SubmissionStatus @default(pending)
  teamId      String?          @map("team_id")

  user     User       @relation(fields: [userId], references: [id])
  module   Module     @relation(fields: [moduleId], references: [id])
  team     Team?      @relation(fields: [teamId], references: [id])
  reviews  Review[]
  xpLedger XpLedger[]

  @@map("submissions")
}

model Review {
  id           String       @id @default(uuid())
  submissionId String       @map("submission_id")
  reviewerType ReviewerType @map("reviewer_type")
  reviewerId   String?      @map("reviewer_id")
  outcome      String?
  feedbackText String?      @map("feedback_text")
  reviewedAt   DateTime     @default(now()) @map("reviewed_at")

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User?      @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}

model XpLedger {
  id                  String       @id @default(uuid())
  submissionId        String       @map("submission_id")
  scoredBy            ReviewerType @map("scored_by")
  xpAwarded           Int          @map("xp_awarded")
  individualComponent Int?         @map("individual_component")
  teamComponent       Int?         @map("team_component")
  createdAt           DateTime     @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id])

  @@map("xp_ledger")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_members")
}

model Notification {
  id           String           @id @default(uuid())
  targetUserId String?          @map("target_user_id")
  targetRole   String?          @map("target_role")
  type         NotificationType
  trigger      String?
  sentAt       DateTime         @default(now()) @map("sent_at")

  targetUser User? @relation(fields: [targetUserId], references: [id])

  @@map("notifications")
}
